#!/usr/bin/env bash
# cac - Coding Agent Config CLI
# Manages versioned ZIP-based configuration bundles for AI coding assistants

set -euo pipefail

# Version: YYMMDD-HHMM from HEAD commit
#   clean + pushed   → 260218-1330         (release)
#   clean + unpushed → 260218-1330-draft   (push pending)
#   uncommitted      → 260218-1655-dirty   (uncommitted changes)
# install.sh bakes the version string in at install time
VERSION="dev"
_tool_dir="$(dirname "${BASH_SOURCE[0]:-$0}")"
if git -C "$_tool_dir" rev-parse --git-dir &>/dev/null; then
    VERSION=$(git -C "$_tool_dir" log -1 --format='%cd' --date=format:'%y%m%d-%H%M' HEAD 2>/dev/null || echo "dev")
    if ! git -C "$_tool_dir" diff --quiet HEAD 2>/dev/null || ! git -C "$_tool_dir" diff --cached --quiet HEAD 2>/dev/null; then
        VERSION="${VERSION}-dirty"
    elif ! git -C "$_tool_dir" diff --quiet HEAD "@{upstream}" 2>/dev/null; then
        VERSION="${VERSION}-draft"
    fi
fi
unset _tool_dir

# Determine script location and library path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

# Source library modules
# Note: logging.sh is the base (no deps), security.sh sources it,
# config.sh sources security.sh. Each module sources its dependencies.
# shellcheck source=lib/config.sh
source "${LIB_DIR}/config.sh"
# shellcheck source=lib/tools.sh
source "${LIB_DIR}/tools.sh"
# shellcheck source=lib/bundle.sh
source "${LIB_DIR}/bundle.sh"
# shellcheck source=lib/utils.sh
source "${LIB_DIR}/utils.sh"
# shellcheck source=lib/backend_local.sh
source "${LIB_DIR}/backend_local.sh"
# shellcheck source=lib/backend_gokapi.sh
source "${LIB_DIR}/backend_gokapi.sh"
# shellcheck source=lib/check.sh
source "${LIB_DIR}/check.sh"
# shellcheck source=lib/env.sh
source "${LIB_DIR}/env.sh"
# shellcheck source=lib/skill.sh
source "${LIB_DIR}/skill.sh"
# shellcheck source=lib/update.sh
source "${LIB_DIR}/update.sh"

# ============================================================================
# Help / Usage
# ============================================================================

show_help() {
    cat <<EOF
cac - Coding Agent Config CLI v${VERSION}

Manages versioned ZIP-based configuration bundles for AI coding assistants
(Claude Code, Codex CLI, Gemini CLI, Mistral Vibe).

USAGE:
    cac <command> [options]

COMMANDS:
    push [--tool TOOL] [--user USER] [--dry-run] [--skip-check]
                                    Create and upload config bundle
    pull [BUNDLE_ID] [--tool TOOL] [--user USER] [--dry-run] [--all]
                                    Download and apply bundle (newest or specific)
    list [--tool TOOL] [--user USER]  List available bundles
    check [TOOL] [--user USER]      Verify AI tool credentials work
    test [--user USER]              (Alias for check) Test API connectivity
    update [--check]                Self-update cac to the latest version
    env install [TOOL] [--user|--global] [--tmux]  Install AI tool environments
    env update [TOOL] [--user|--global]   Update AI tool environments
    env status [--parseable] [--check-updates]  Show AI tool installation status
    env check [TOOL] [--parseable]        Health-check installed AI tool environments
    env repair [TOOL] [--yes]             Repair detected environment issues
    skill install <URL> [--global] [--yes]  Install a skill library from Git
    skill update [LIBRARY] [--yes]          Update installed skill libraries
    skill list                              List installed skill libraries
    skill status                            Show libraries with update info

SUPPORTED TOOLS:
    claude          Claude Code (Anthropic)
    codex           Codex CLI (OpenAI)
    gemini          Gemini CLI (Google)
    mistral         Mistral Vibe (Mistral AI)

OPTIONS:
    --user USER     Operate on specified user (requires root for other users)
    --tool TOOL     Filter bundles by AI tool name (pull, list)
    --all           Pull to all users with AI tool configs (requires root)
    --dry-run       Preview what would happen without making changes
    --skip-check    Skip credential verification before push
    --check-updates Check for latest versions (env status only)
    --tmux          Set Claude Code teammateMode to "tmux" (env install only)
    --verbose       Enable verbose output for debugging
    --help, -h      Show this help message
    --version, -v   Show version information

EXAMPLES:
    cac push                    Bundle and upload current user's config (all tools)
    cac push --tool claude      Bundle and upload only Claude credentials
    cac push --tool codex       Bundle and upload only Codex credentials
    cac push --dry-run          Preview what would be bundled
    cac push --skip-check       Skip credential verification before upload
    cac push --user ubuntu      Bundle ubuntu user's config (requires root)
    cac pull                    Apply globally newest bundle
    cac pull --tool claude      Apply newest bundle for Claude tool
    cac pull --user bob         Apply newest bundle to user bob (requires root)
    cac pull --dry-run          Preview what would be extracted
    cac pull CodingAgentConfig_myhost_user_250111-120000.zip
                                Download and apply a specific bundle
    cac pull mybundle           Partial match on bundle name
    sudo cac pull --all         Pull config to all users with AI tool dirs
    cac list                    List all available bundles
    cac list --tool codex       List bundles for Codex tool
    cac check                   Verify all AI tool credentials work
    cac check claude            Verify only Claude credentials
    cac check codex             Verify only Codex credentials
    cac check gemini            Verify only Gemini credentials
    cac check mistral           Verify only Mistral credentials
    cac check --user bob        Verify credentials for user bob (requires root)
    cac update                  Update cac to the latest version
    cac update --check          Check if an update is available
    cac env status              Show AI tool installation status
    cac env status --check-updates  Show status with update availability
    cac env install claude      Install Claude Code CLI
    cac env install mistral     Install Mistral Vibe CLI
    cac env install --global    Install all AI tools system-wide (requires root)
    cac env update codex        Update Codex CLI
    cac env check                   Health-check all installed tools
    cac env repair --yes            Auto-repair all detected issues
    cac env --help              Show full env subcommand help
    cac skill install https://github.com/BPMspaceUG/bpm-claude-global-agent-skill-library.git
                                    Install BPM skill library
    cac skill list              List installed skill libraries
    cac skill update            Update all installed skill libraries
    cac skill --help            Show full skill subcommand help

CONFIGURATION:
    Config file locations (in order of precedence):
      \$CAC_CONFIG_DIR/.env
      \$XDG_CONFIG_HOME/cac/.env
      ~/.config/cac/.env
      /etc/cac/.env

    Required .env variables:
      CAC_BACKEND=local|gokapi
      CAC_LOCAL_STORAGE=/path/to/storage   (for local backend)
      CAC_GOKAPI_URL=https://...           (for gokapi backend)
      CAC_GOKAPI_API_KEY=...               (for gokapi backend)

EOF
}

show_version() {
    echo "cac version ${VERSION}"
}

# ============================================================================
# Commands
# ============================================================================

cmd_push() {
    local explicit_tool="all"
    local args=()

    # Pre-parse push-specific --tool/-t flag or positional tool argument
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tool|-t)
                if [[ $# -lt 2 ]]; then
                    utils_error "Option $1 requires an argument"
                    return 1
                fi
                explicit_tool="$(_resolve_tool_alias "$2")"
                if ! tools_is_valid "$explicit_tool"; then
                    utils_error "Unknown tool: $2"
                    echo "Valid tools: claude codex gemini mistral" >&2
                    return 1
                fi
                shift 2
                ;;
            -*)
                args+=("$1")
                shift
                ;;
            *)
                # Positional arg: tool name if valid, otherwise pass through
                local resolved
                resolved="$(_resolve_tool_alias "$1")"
                if tools_is_valid "$resolved"; then
                    explicit_tool="$resolved"
                else
                    args+=("$1")
                fi
                shift
                ;;
        esac
    done

    # Parse remaining arguments including --skip-check, validate user access, and resolve home directory
    if ! utils_init_push_context --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    local dry_run="$PARSED_DRY_RUN"
    local skip_check="$PARSED_SKIP_CHECK"
    local home_dir="$PARSED_HOME_DIR"

    # Check if any config files exist for the selected tool
    local file_count
    file_count=$(tools_count_existing "$home_dir" "$explicit_tool" "--include-settings")
    if [[ "$file_count" -eq 0 ]]; then
        if [[ "$explicit_tool" != "all" ]]; then
            utils_error "No configuration files found for tool '$explicit_tool' (user '$target_user')"
        else
            utils_error "No AI tool configuration files found for user '$target_user'"
        fi
        return 1
    fi

    # Generate bundle filename for display
    local bundle_name
    bundle_name=$(bundle_generate_filename "$target_user" "$explicit_tool")

    # Show what would happen (always shown, dry-run stops here)
    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "Would create bundle for user: $target_user"
        [[ "$explicit_tool" != "all" ]] && utils_dryrun "Tool filter: $explicit_tool"
        utils_dryrun "Home directory: $home_dir"
        utils_dryrun "Files to include: $file_count"
        utils_dryrun "Bundle name: $bundle_name"
        utils_dryrun "Backend: ${CAC_BACKEND}"
        if [[ "$skip_check" == "true" ]]; then
            utils_dryrun "Credential check: SKIPPED"
        else
            utils_dryrun "Credential check: Would run before push"
        fi
        echo ""
        echo "Files that would be bundled:"
        # Use process substitution to avoid pipe subshell masking errors
        while IFS= read -r file; do
            echo "  - $file"
        done < <(tools_collect_existing "$home_dir" "$explicit_tool" "--include-settings")
        utils_dryrun_footer
        return 0
    fi

    # Run credential check before push (unless skipped)
    if [[ "$skip_check" != "true" ]]; then
        echo "=== Verifying credentials before push ==="
        echo ""

        local use_sudo="false"
        if [[ "$target_user" != "$(whoami)" ]]; then
            use_sudo="true"
        fi

        if [[ "$explicit_tool" != "all" ]]; then
            # Check only the specific tool being pushed
            if ! check_single_tool "$explicit_tool" "$use_sudo" "$target_user" "$home_dir"; then
                utils_error "Credential check failed for $explicit_tool. Use --skip-check to bypass."
                return 1
            fi
        else
            if ! check_all_tools "$use_sudo" "$target_user" "$home_dir"; then
                utils_error "Credential check failed. Use --skip-check to bypass."
                return 1
            fi
        fi
        echo ""
    fi

    echo "Creating bundle for user: $target_user"
    [[ "$explicit_tool" != "all" ]] && echo "Tool: $explicit_tool"
    echo "Home directory: $home_dir"
    echo "Files found: $file_count"
    echo ""

    # Create temp directory for bundle (cleaned on return)
    local temp_dir
    security_init_temp_dir temp_dir "cac-push"
    trap '[[ -n "${temp_dir:-}" ]] && rm -rf "$temp_dir"' RETURN

    local bundle_path="${temp_dir}/${bundle_name}"

    if ! bundle_create "$home_dir" "$bundle_path" "$explicit_tool"; then
        return 1
    fi

    # Upload to backend
    if ! backend_call upload "$bundle_path"; then
        utils_error "Failed to upload bundle to ${CAC_BACKEND} backend"
        return 1
    fi

    utils_success "Bundle uploaded successfully: $bundle_name"
}

cmd_pull() {
    local pull_all="false"
    local dry_run="false"
    local explicit_tool=""
    local tool_provided="false"
    local bundle_id=""
    local args=()

    # Pre-parse pull-specific flags (--all, --tool need special handling)
    # and capture optional positional BUNDLE_ID argument
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)
                pull_all="true"
                shift
                ;;
            --tool)
                if [[ $# -lt 2 ]]; then
                    utils_error "Option --tool requires an argument"
                    return 1
                fi
                explicit_tool="$2"
                tool_provided="true"
                shift 2
                ;;
            --dry-run)
                dry_run="true"
                args+=("$1")
                shift
                ;;
            --*)
                # Pass other flags through for standard parsing
                args+=("$1")
                shift
                ;;
            *)
                # First non-flag argument is the BUNDLE_ID
                if [[ -z "$bundle_id" ]]; then
                    bundle_id="$1"
                else
                    args+=("$1")
                fi
                shift
                ;;
        esac
    done

    # Handle --all mode
    if [[ "$pull_all" == "true" ]]; then
        cmd_pull_all "$dry_run"
        return $?
    fi

    # Parse arguments, validate user access, and resolve home directory
    if ! utils_init_command_context --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    dry_run="$PARSED_DRY_RUN"
    local home_dir="$PARSED_HOME_DIR"

    # If a specific BUNDLE_ID was provided, download that bundle directly
    if [[ -n "$bundle_id" ]]; then
        # Show what would happen (dry-run stops here)
        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would get bundle: $bundle_id"
            utils_dryrun "Target user: $target_user"
            utils_dryrun "Target directory: $home_dir"
            echo ""
            utils_preview_extraction "$bundle_id" "$home_dir"
            utils_dryrun_footer
            return 0
        fi

        echo "Getting bundle: $bundle_id"
        echo "Target user: $target_user"

        # Download and extract
        if ! utils_download_and_extract "$bundle_id" "$home_dir" "$target_user"; then
            return 1
        fi

        echo ""
        echo "Pull complete!"
        return 0
    fi

    # Build backend filter arguments (only pass explicitly provided filters)
    local filter_args=()
    if [[ "$tool_provided" == "true" ]]; then
        filter_args+=(--tool "$explicit_tool")
    fi
    if [[ -n "$PARSED_USER" ]]; then
        filter_args+=(--user "$PARSED_USER")
    fi

    # Find newest matching bundle (globally unless filters are specified)
    local newest_bundle
    if ! newest_bundle=$(backend_call get_newest "${filter_args[@]+"${filter_args[@]}"}"); then
        if [[ ${#filter_args[@]} -gt 0 ]]; then
            utils_error "No bundle found matching ${filter_args[*]}"
        else
            utils_error "No bundle found"
        fi
        return 1
    fi

    # Show what would happen (dry-run stops here)
    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "Would pull newest bundle (applying to user: $target_user)"
        if [[ ${#filter_args[@]} -gt 0 ]]; then
            utils_dryrun "Filters: ${filter_args[*]}"
        else
            utils_dryrun "Filters: none (global newest)"
        fi
        utils_dryrun "Target directory: $home_dir"
        utils_dryrun "Bundle to download: $newest_bundle"
        echo ""
        utils_preview_extraction "$newest_bundle" "$home_dir"
        utils_dryrun_footer
        return 0
    fi

    echo "Pulling newest bundle (applying to user: $target_user)"
    if [[ ${#filter_args[@]} -gt 0 ]]; then
        echo "Filters: ${filter_args[*]}"
    fi
    echo ""
    echo "Found bundle: $newest_bundle"

    # Download and extract
    if ! utils_download_and_extract "$newest_bundle" "$home_dir" "$target_user"; then
        return 1
    fi

    echo ""
    echo "Pull complete!"
}

# Pull config to all users who have AI tool directories
cmd_pull_all() {
    local dry_run="${1:-false}"

    # Require root
    if [[ "$EUID" -ne 0 ]]; then
        utils_error "Root required for --all (pulls to all users)"
        return 1
    fi

    echo "=== Pulling config to all AI tool users ==="
    echo ""

    # Find users with AI tool config directories or files
    local users_found=()
    local tool_dirs=(".claude" ".codex" ".gemini" ".vibe")
    local tool_files=(".claude.json")

    for user_home in /home/*; do
        [[ -d "$user_home" ]] || continue
        local username
        username=$(basename "$user_home")
        local found=false

        # Check for config directories
        for tool_dir in "${tool_dirs[@]}"; do
            if [[ -d "${user_home}/${tool_dir}" ]]; then
                found=true
                break
            fi
        done

        # Check for config files (e.g., .claude.json)
        if [[ "$found" != "true" ]]; then
            for tool_file in "${tool_files[@]}"; do
                if [[ -f "${user_home}/${tool_file}" ]]; then
                    found=true
                    break
                fi
            done
        fi

        if [[ "$found" == "true" && ! " ${users_found[*]} " =~ \ ${username}\  ]]; then
            users_found+=("$username")
        fi
    done

    # Also check root
    local root_found=false
    for tool_dir in "${tool_dirs[@]}"; do
        if [[ -d "/root/${tool_dir}" ]]; then
            root_found=true
            break
        fi
    done
    if [[ "$root_found" != "true" ]]; then
        for tool_file in "${tool_files[@]}"; do
            if [[ -f "/root/${tool_file}" ]]; then
                root_found=true
                break
            fi
        done
    fi
    if [[ "$root_found" == "true" ]]; then
        users_found+=("root")
    fi

    if [[ ${#users_found[@]} -eq 0 ]]; then
        echo "No users with AI tool configs found (.claude, .codex, .gemini, .claude.json)"
        return 0
    fi

    echo "Found ${#users_found[@]} user(s) with AI tool configs:"
    printf '  - %s\n' "${users_found[@]}"
    echo ""

    local success=0
    local failed=0

    for username in "${users_found[@]}"; do
        echo "--- Processing: $username ---"

        local home_dir
        if [[ "$username" == "root" ]]; then
            home_dir="/root"
        else
            home_dir="/home/$username"
        fi

        # Find newest bundle for this user
        local newest_bundle
        if ! newest_bundle=$(backend_call get_newest --user "$username" 2>/dev/null); then
            echo "  No bundle found for $username, skipping"
            echo ""
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would pull $newest_bundle to $home_dir"
        else
            echo "  Bundle: $newest_bundle"
            if utils_download_and_extract "$newest_bundle" "$home_dir" "$username"; then
                echo "  OK"
                ((success++)) || true
            else
                echo "  FAILED"
                ((failed++)) || true
            fi
        fi
        echo ""
    done

    echo "=== Summary ==="
    echo "Success: $success, Failed: $failed, Total: ${#users_found[@]}"
}

# Silent alias: 'cac get' redirects to 'cac pull' for backward compatibility
cmd_get() {
    cmd_pull "$@"
}

cmd_list() {
    backend_call list "$@"
}

cmd_check() {
    local tool_arg=""
    local args=()

    # Extract tool argument (first non-option argument), resolve aliases
    for arg in "$@"; do
        if [[ "$arg" != --* && -z "$tool_arg" ]]; then
            tool_arg="$(_resolve_tool_alias "$arg")"
        else
            args+=("$arg")
        fi
    done

    # Parse remaining arguments
    if ! utils_parse_user_arg --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="${PARSED_USER:-$USER}"
    local use_sudo="false"

    # Check if checking another user
    if [[ "$target_user" != "$(whoami)" ]]; then
        if [[ "$EUID" -ne 0 ]]; then
            utils_error "Root required to check as another user"
            return 1
        fi
        use_sudo="true"
    fi

    # Resolve home directory
    local home_dir
    if ! home_dir=$(security_resolve_user_home "$target_user"); then
        return 1
    fi

    echo "=== Checking AI Tool Credentials for user: $target_user ==="
    echo ""

    if [[ -n "$tool_arg" ]]; then
        # Check specific tool
        check_single_tool "$tool_arg" "$use_sudo" "$target_user" "$home_dir"
    else
        # Check all tools
        check_all_tools "$use_sudo" "$target_user" "$home_dir"
    fi
}

# Alias: cmd_test is now an alias for cmd_check (backward compatibility)
cmd_test() {
    cmd_check "$@"
}

cmd_env() {
    local subcommand="${1:-status}"
    shift || true

    # Resolve tool aliases in arguments (e.g., "vibe" -> "mistral")
    local resolved_args=()
    for arg in "$@"; do
        if [[ "$arg" != -* ]]; then
            resolved_args+=("$(_resolve_tool_alias "$arg")")
        else
            resolved_args+=("$arg")
        fi
    done

    case "$subcommand" in
        install)
            env_cmd_install "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        update)
            env_cmd_update "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        status)
            env_cmd_status "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        check)
            env_cmd_check "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        repair)
            env_cmd_repair "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        skills)
            env_cmd_skills "$@"
            ;;
        --help|-h)
            cat <<EOF
cac env - Manage AI tool environments

USAGE:
    cac env <subcommand> [options]

SUBCOMMANDS:
    install [TOOL] [--user|--global] [--yes] [--tmux]  Install AI tool environments
    update [TOOL] [--user|--global]           Update AI tool environments
    status [--parseable] [--check-updates]    Show installation status
    check [TOOL] [--parseable]               Health-check installed tools
    repair [TOOL] [--yes]                    Repair detected health issues
    skills [--yes] [--list]                  Install predefined Claude Code skills

TOOLS:
    claude            Claude Code CLI
    codex             OpenAI Codex CLI
    gemini            Google Gemini CLI
    mistral (vibe)    Mistral Vibe CLI
    continuous-claude continuous-claude (optional)

OPTIONS:
    --user            Install/update for current user only (default)
    --global          Install/update system-wide (requires root)
    --yes, -y         Skip confirmation prompts
    --parseable       Output status in tab-separated format
    --check-updates   Check for latest versions (env status only)
    --tmux            Set Claude Code teammateMode to "tmux" (install only)

EXAMPLES:
    cac env status                    Show status of all AI tools
    cac env install                   Interactive tool selection
    cac env install claude            Install Claude Code
    cac env install --global          Install all tools system-wide
    cac env update codex              Update Codex CLI
    cac env status --parseable        Machine-readable status output
    cac env status --check-updates    Show status with update availability
    cac env check                     Health-check all installed AI tools
    cac env check claude              Check only Claude Code health
    cac env check --parseable         Machine-readable check output
    cac env repair                    Repair all detected issues (interactive)
    cac env repair --yes              Repair without confirmation prompts
    cac env repair codex              Repair only Codex CLI
    cac env skills                    Install predefined Claude Code skills
    cac env skills --list             List predefined skills without installing

EOF
            ;;
        *)
            utils_error "Unknown env subcommand: $subcommand"
            echo "Run 'cac env --help' for usage information." >&2
            return 1
            ;;
    esac
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Handle global options first (can appear before or after command)
    local args=()
    for arg in "$@"; do
        case "$arg" in
            --verbose)
                logging_set_verbose
                ;;
            *)
                args+=("$arg")
                ;;
        esac
    done
    set -- "${args[@]}"

    # Handle help and version first (no config required)
    case "${1:-}" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v)
            show_version
            exit 0
            ;;
        "")
            show_help
            exit 0
            ;;
    esac

    # Print version on every command invocation
    echo "cac v${VERSION}"

    local command="$1"
    shift

    utils_verbose "Command: $command"

    # Check/test/env commands don't require backend config
    if [[ "$command" == "check" || "$command" == "test" ]]; then
        cmd_check "$@"
        exit $?
    fi

    if [[ "$command" == "env" ]]; then
        cmd_env "$@"
        exit $?
    fi

    if [[ "$command" == "skill" ]]; then
        skill_cmd_main "$@"
        exit $?
    fi

    if [[ "$command" == "update" ]]; then
        update_cmd_main "$@"
        exit $?
    fi

    # Load configuration for all other commands
    if ! config_load; then
        exit 1
    fi

    if ! config_validate; then
        exit 1
    fi

    # Dispatch command
    case "$command" in
        push)
            cmd_push "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        get)
            cmd_get "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        *)
            utils_error "Unknown command: $command"
            echo "Run 'cac --help' for usage information." >&2
            exit 1
            ;;
    esac
}

# When sourced as a library (e.g., tests), skip main execution.
# Standard bash idiom: 'return' is valid only when sourced.
(return 0 2>/dev/null) || main "$@"
