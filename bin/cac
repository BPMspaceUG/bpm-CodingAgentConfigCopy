#!/usr/bin/env bash
# cac - Coding Agent Config CLI
# Manages versioned ZIP-based configuration bundles for AI coding assistants

set -euo pipefail

VERSION="260119-182719"

# Determine script location and library path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

# Source library modules
# Note: logging.sh is the base (no deps), security.sh sources it,
# config.sh sources security.sh. Each module sources its dependencies.
# shellcheck source=lib/config.sh
source "${LIB_DIR}/config.sh"
# shellcheck source=lib/tools.sh
source "${LIB_DIR}/tools.sh"
# shellcheck source=lib/bundle.sh
source "${LIB_DIR}/bundle.sh"
# shellcheck source=lib/utils.sh
source "${LIB_DIR}/utils.sh"
# shellcheck source=lib/backend_local.sh
source "${LIB_DIR}/backend_local.sh"
# shellcheck source=lib/backend_gokapi.sh
source "${LIB_DIR}/backend_gokapi.sh"
# shellcheck source=lib/check.sh
source "${LIB_DIR}/check.sh"

# ============================================================================
# Help / Usage
# ============================================================================

show_help() {
    cat <<EOF
cac - Coding Agent Config CLI v${VERSION}

Manages versioned ZIP-based configuration bundles for AI coding assistants
(Claude Code, Codex CLI, Gemini CLI).

USAGE:
    cac <command> [options]

COMMANDS:
    push [--user USER] [--dry-run] [--skip-check]  Create and upload config bundle
    pull [--user USER] [--dry-run] [--all]  Download and apply newest matching bundle
    get [BUNDLE_ID] [--dry-run]     Download a specific bundle (by ID or interactive)
    list [--host HOST] [--user USER]  List available bundles
    check [TOOL] [--user USER]      Verify AI tool credentials work
    test [--user USER]              (Alias for check) Test API connectivity

OPTIONS:
    --user USER     Operate on specified user (requires root for other users)
    --host HOST     Filter bundles by hostname
    --all           Pull to all users with AI tool configs (requires root)
    --dry-run       Preview what would happen without making changes
    --skip-check    Skip credential verification before push
    --verbose       Enable verbose output for debugging
    --help, -h      Show this help message
    --version, -v   Show version information

EXAMPLES:
    cac push                    Bundle and upload current user's config
    cac push --dry-run          Preview what would be bundled
    cac push --skip-check       Skip credential verification before upload
    cac push --user ubuntu      Bundle ubuntu user's config (requires root)
    cac pull                    Apply newest bundle for current user/host
    cac pull --dry-run          Preview what would be extracted
    cac pull --user bob         Apply newest bundle to user bob (requires root)
    sudo cac pull --all         Pull config to all users with AI tool dirs
    cac list                    List all available bundles
    cac list --host prod-01     List bundles from specific host
    cac get                     Interactive bundle selection
    cac get CodingAgentConfig_myhost_user_250111-120000.zip
    cac get mybundle --dry-run  Preview what would be extracted from specific bundle
    cac check                   Verify all AI tool credentials work
    cac check claude            Verify only Claude credentials
    cac check --user bob        Verify credentials for user bob (requires root)

CONFIGURATION:
    Config file locations (in order of precedence):
      \$CAC_CONFIG_DIR/.env
      \$XDG_CONFIG_HOME/cac/.env
      ~/.config/cac/.env
      /etc/cac/.env

    Required .env variables:
      CAC_BACKEND=local|gokapi
      CAC_LOCAL_STORAGE=/path/to/storage   (for local backend)
      CAC_GOKAPI_URL=https://...           (for gokapi backend)
      CAC_GOKAPI_API_KEY=...               (for gokapi backend)

EOF
}

show_version() {
    echo "cac version ${VERSION}"
}

# ============================================================================
# Commands
# ============================================================================

cmd_push() {
    # Parse arguments including --skip-check, validate user access, and resolve home directory
    if ! utils_init_push_context --strict "$@"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    local dry_run="$PARSED_DRY_RUN"
    local skip_check="$PARSED_SKIP_CHECK"
    local home_dir="$PARSED_HOME_DIR"

    # Check if any config files exist
    local file_count
    file_count=$(tools_count_existing "$home_dir" "all")
    if [[ "$file_count" -eq 0 ]]; then
        utils_error "No AI tool configuration files found for user '$target_user'"
        return 1
    fi

    # Generate bundle filename for display
    local bundle_name
    bundle_name=$(bundle_generate_filename "$target_user")

    # Show what would happen (always shown, dry-run stops here)
    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "Would create bundle for user: $target_user"
        utils_dryrun "Home directory: $home_dir"
        utils_dryrun "Files to include: $file_count"
        utils_dryrun "Bundle name: $bundle_name"
        utils_dryrun "Backend: ${CAC_BACKEND}"
        if [[ "$skip_check" == "true" ]]; then
            utils_dryrun "Credential check: SKIPPED"
        else
            utils_dryrun "Credential check: Would run before push"
        fi
        echo ""
        echo "Files that would be bundled:"
        # Use process substitution to avoid pipe subshell masking errors
        while IFS= read -r file; do
            echo "  - $file"
        done < <(tools_collect_existing "$home_dir" "all")
        utils_dryrun_footer
        return 0
    fi

    # Run credential check before push (unless skipped)
    if [[ "$skip_check" != "true" ]]; then
        echo "=== Verifying credentials before push ==="
        echo ""

        local use_sudo="false"
        if [[ "$target_user" != "$(whoami)" ]]; then
            use_sudo="true"
        fi

        if ! check_all_tools "$use_sudo" "$target_user" "$home_dir"; then
            utils_error "Credential check failed. Use --skip-check to bypass."
            return 1
        fi
        echo ""
    fi

    echo "Creating bundle for user: $target_user"
    echo "Home directory: $home_dir"
    echo "Files found: $file_count"
    echo ""

    # Create temp directory for bundle (auto-cleaned on return)
    local temp_dir
    security_init_temp_dir temp_dir "cac-push"

    local bundle_path="${temp_dir}/${bundle_name}"

    if ! bundle_create "$home_dir" "$bundle_path" "all"; then
        return 1
    fi

    # Upload to backend
    if ! backend_call upload "$bundle_path"; then
        utils_error "Failed to upload bundle to ${CAC_BACKEND} backend"
        return 1
    fi

    utils_success "Bundle uploaded successfully: $bundle_name"
}

cmd_pull() {
    local pull_all="false"
    local dry_run="false"
    local args=()

    # Check for --all flag
    for arg in "$@"; do
        if [[ "$arg" == "--all" ]]; then
            pull_all="true"
        elif [[ "$arg" == "--dry-run" ]]; then
            dry_run="true"
            args+=("$arg")
        else
            args+=("$arg")
        fi
    done

    # Handle --all mode
    if [[ "$pull_all" == "true" ]]; then
        cmd_pull_all "$dry_run"
        return $?
    fi

    # Parse arguments, validate user access, and resolve home directory
    if ! utils_init_command_context --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    dry_run="$PARSED_DRY_RUN"
    local home_dir="$PARSED_HOME_DIR"
    local target_host
    target_host=$(hostname -s)

    # Find newest matching bundle
    local newest_bundle
    if ! newest_bundle=$(backend_call get_newest --host "$target_host" --user "$target_user"); then
        utils_error "No bundle found matching host='$target_host', user='$target_user'"
        return 1
    fi

    # Show what would happen (dry-run stops here)
    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "Would pull bundle for user: $target_user, host: $target_host"
        utils_dryrun "Target directory: $home_dir"
        utils_dryrun "Bundle to download: $newest_bundle"
        echo ""
        utils_preview_extraction "$newest_bundle" "$home_dir"
        utils_dryrun_footer
        return 0
    fi

    echo "Pulling newest bundle for user: $target_user, host: $target_host"
    echo ""
    echo "Found bundle: $newest_bundle"

    # Download and extract
    if ! utils_download_and_extract "$newest_bundle" "$home_dir" "$target_user"; then
        return 1
    fi

    echo ""
    echo "Pull complete!"
}

# Pull config to all users who have AI tool directories
cmd_pull_all() {
    local dry_run="${1:-false}"

    # Require root
    if [[ "$EUID" -ne 0 ]]; then
        utils_error "Root required for --all (pulls to all users)"
        return 1
    fi

    echo "=== Pulling config to all AI tool users ==="
    echo ""

    local target_host
    target_host=$(hostname -s)

    # Find users with AI tool config directories or files
    local users_found=()
    local tool_dirs=(".claude" ".codex" ".gemini")
    local tool_files=(".claude.json")

    for user_home in /home/*; do
        [[ -d "$user_home" ]] || continue
        local username
        username=$(basename "$user_home")
        local found=false

        # Check for config directories
        for tool_dir in "${tool_dirs[@]}"; do
            if [[ -d "${user_home}/${tool_dir}" ]]; then
                found=true
                break
            fi
        done

        # Check for config files (e.g., .claude.json)
        if [[ "$found" != "true" ]]; then
            for tool_file in "${tool_files[@]}"; do
                if [[ -f "${user_home}/${tool_file}" ]]; then
                    found=true
                    break
                fi
            done
        fi

        if [[ "$found" == "true" && ! " ${users_found[*]} " =~ " ${username} " ]]; then
            users_found+=("$username")
        fi
    done

    # Also check root
    local root_found=false
    for tool_dir in "${tool_dirs[@]}"; do
        if [[ -d "/root/${tool_dir}" ]]; then
            root_found=true
            break
        fi
    done
    if [[ "$root_found" != "true" ]]; then
        for tool_file in "${tool_files[@]}"; do
            if [[ -f "/root/${tool_file}" ]]; then
                root_found=true
                break
            fi
        done
    fi
    if [[ "$root_found" == "true" ]]; then
        users_found+=("root")
    fi

    if [[ ${#users_found[@]} -eq 0 ]]; then
        echo "No users with AI tool configs found (.claude, .codex, .gemini, .claude.json)"
        return 0
    fi

    echo "Found ${#users_found[@]} user(s) with AI tool configs:"
    printf '  - %s\n' "${users_found[@]}"
    echo ""

    local success=0
    local failed=0

    for username in "${users_found[@]}"; do
        echo "--- Processing: $username ---"

        local home_dir
        if [[ "$username" == "root" ]]; then
            home_dir="/root"
        else
            home_dir="/home/$username"
        fi

        # Find newest bundle for this user
        local newest_bundle
        if ! newest_bundle=$(backend_call get_newest --host "$target_host" --user "$username" 2>/dev/null); then
            echo "  No bundle found for $username@$target_host, skipping"
            echo ""
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would pull $newest_bundle to $home_dir"
        else
            echo "  Bundle: $newest_bundle"
            if utils_download_and_extract "$newest_bundle" "$home_dir" "$username"; then
                echo "  OK"
                ((success++))
            else
                echo "  FAILED"
                ((failed++))
            fi
        fi
        echo ""
    done

    echo "=== Summary ==="
    echo "Success: $success, Failed: $failed, Total: ${#users_found[@]}"
}

cmd_get() {
    local bundle_id="${1:-}"

    # Parse remaining args, validate user access, and resolve home directory (non-strict)
    shift || true
    if ! utils_init_command_context "$@"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    local dry_run="$PARSED_DRY_RUN"
    local home_dir="$PARSED_HOME_DIR"

    # If no bundle_id provided, show list and prompt
    if [[ -z "$bundle_id" ]]; then
        echo "Available bundles:"
        echo ""
        cmd_list
        echo ""
        echo "Enter bundle name (or partial match):"
        read -r bundle_id

        if [[ -z "$bundle_id" ]]; then
            echo "No bundle selected" >&2
            return 1
        fi
    fi

    # Show what would happen (dry-run stops here)
    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "Would get bundle: $bundle_id"
        utils_dryrun "Target user: $target_user"
        utils_dryrun "Target directory: $home_dir"
        echo ""
        utils_preview_extraction "$bundle_id" "$home_dir"
        utils_dryrun_footer
        return 0
    fi

    echo "Getting bundle: $bundle_id"
    echo "Target user: $target_user"

    # Download and extract
    if ! utils_download_and_extract "$bundle_id" "$home_dir" "$target_user"; then
        return 1
    fi

    echo ""
    echo "Get complete!"
}

cmd_list() {
    backend_call list "$@"
}

cmd_check() {
    echo "cac v${VERSION}"
    echo ""
    local tool_arg=""
    local args=()

    # Extract tool argument (first non-option argument)
    for arg in "$@"; do
        if [[ "$arg" != --* && -z "$tool_arg" ]]; then
            tool_arg="$arg"
        else
            args+=("$arg")
        fi
    done

    # Parse remaining arguments
    if ! utils_parse_user_arg --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="${PARSED_USER:-$USER}"
    local use_sudo="false"

    # Check if checking another user
    if [[ "$target_user" != "$(whoami)" ]]; then
        if [[ "$EUID" -ne 0 ]]; then
            utils_error "Root required to check as another user"
            return 1
        fi
        use_sudo="true"
    fi

    # Resolve home directory
    local home_dir
    if ! home_dir=$(security_resolve_user_home "$target_user"); then
        return 1
    fi

    echo "=== Checking AI Tool Credentials for user: $target_user ==="
    echo ""

    if [[ -n "$tool_arg" ]]; then
        # Check specific tool
        check_single_tool "$tool_arg" "$use_sudo" "$target_user" "$home_dir"
    else
        # Check all tools
        check_all_tools "$use_sudo" "$target_user" "$home_dir"
    fi
}

# Alias: cmd_test is now an alias for cmd_check (backward compatibility)
cmd_test() {
    cmd_check "$@"
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Handle global options first (can appear before or after command)
    local args=()
    for arg in "$@"; do
        case "$arg" in
            --verbose)
                logging_set_verbose
                ;;
            *)
                args+=("$arg")
                ;;
        esac
    done
    set -- "${args[@]}"

    # Handle help and version first (no config required)
    case "${1:-}" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v)
            show_version
            exit 0
            ;;
        "")
            show_help
            exit 0
            ;;
    esac

    local command="$1"
    shift

    utils_verbose "Command: $command"

    # Check/test commands don't require backend config
    if [[ "$command" == "check" || "$command" == "test" ]]; then
        cmd_check "$@"
        exit $?
    fi

    # Load configuration for all other commands
    if ! config_load; then
        exit 1
    fi

    if ! config_validate; then
        exit 1
    fi

    # Dispatch command
    case "$command" in
        push)
            cmd_push "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        get)
            cmd_get "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        *)
            utils_error "Unknown command: $command"
            echo "Run 'cac --help' for usage information." >&2
            exit 1
            ;;
    esac
}

main "$@"
