#!/usr/bin/env bash
# cac - Coding Agent Config CLI
# Manages versioned ZIP-based configuration bundles for AI coding assistants

set -euo pipefail

# Version: YYMMDD-HHMM from HEAD commit
#   clean + pushed   → 260218-1330         (release)
#   clean + unpushed → 260218-1330-draft   (push pending)
#   uncommitted      → 260218-1655-dirty   (uncommitted changes)
# install.sh bakes the version string in at install time
VERSION="dev"
_tool_dir="$(dirname "${BASH_SOURCE[0]:-$0}")"
if git -C "$_tool_dir" rev-parse --git-dir &>/dev/null; then
    VERSION=$(git -C "$_tool_dir" log -1 --format='%cd' --date=format:'%y%m%d-%H%M' HEAD 2>/dev/null || echo "dev")
    if ! git -C "$_tool_dir" diff --quiet HEAD 2>/dev/null || ! git -C "$_tool_dir" diff --cached --quiet HEAD 2>/dev/null; then
        VERSION="${VERSION}-dirty"
    elif ! git -C "$_tool_dir" diff --quiet HEAD "@{upstream}" 2>/dev/null; then
        VERSION="${VERSION}-draft"
    fi
fi
unset _tool_dir

# Determine script location and library path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

# Issue #79: export an absolute path to this entrypoint so env.sh can perform a
# safe `sudo` re-exec for system-wide tool updates without reconstructing the
# command from $0 or guessing via PATH.
export CAC_BIN="${SCRIPT_DIR}/cac"

# Source library modules
# Note: logging.sh is the base (no deps), security.sh sources it,
# config.sh sources security.sh. Each module sources its dependencies.
# shellcheck source=lib/config.sh
source "${LIB_DIR}/config.sh"
# shellcheck source=lib/tools.sh
source "${LIB_DIR}/tools.sh"
# shellcheck source=lib/bundle.sh
source "${LIB_DIR}/bundle.sh"
# shellcheck source=lib/utils.sh
source "${LIB_DIR}/utils.sh"
# shellcheck source=lib/backend_local.sh
source "${LIB_DIR}/backend_local.sh"
# shellcheck source=lib/backend_gokapi.sh
source "${LIB_DIR}/backend_gokapi.sh"
# shellcheck source=lib/check.sh
source "${LIB_DIR}/check.sh"
# shellcheck source=lib/env.sh
source "${LIB_DIR}/env.sh"
# shellcheck source=lib/skill.sh
source "${LIB_DIR}/skill.sh"
# shellcheck source=lib/update.sh
source "${LIB_DIR}/update.sh"

# ============================================================================
# Help / Usage
# ============================================================================

show_help() {
    cat <<EOF
cac - Coding Agent Config CLI v${VERSION}

Manages versioned ZIP-based configuration bundles for AI coding assistants
(Claude Code, Codex CLI, Gemini CLI, Mistral Vibe).

USAGE:
    cac <command> [options]

COMMANDS:
    push [--tool TOOL] [--user USER] [--dry-run] [--check]
                                    Create and upload config bundle
                                    (credential check OFF by default; --check to verify)
    pull [BUNDLE_ID] [--tool TOOL] [--user USER] [--dry-run] [--all]
                                    Download and apply bundle (newest or specific).
                                    No --user: newest bundle per tool, regardless
                                    of uploader. --user X: only bundles uploaded by
                                    X. --all: discover local users and fan out.
    list [--tool TOOL] [--user USER]  List available bundles
    check [TOOL] [--user USER]      Verify AI tool credentials work
    test [--user USER]              (Alias for check) Test API connectivity
    update [--check]                Self-update cac to the latest version
    env install [TOOL] [--user|--global] [--tmux]  Install AI tool environments
    env update [TOOL] [--user|--global]   Update AI tool environments
    env status [--parseable] [--check-updates]  Show AI tool installation status
    env check [TOOL] [--parseable]        Health-check installed AI tool environments
    env repair [TOOL] [--yes]             Repair detected environment issues
    skill install <URL> [--global] [--yes]  Install a skill library from Git
    skill update [LIBRARY] [--yes]          Update installed skill libraries
    skill list                              List installed skill libraries
    skill status                            Show libraries with update info

SUPPORTED TOOLS:
    claude          Claude Code (Anthropic)
    codex           Codex CLI (OpenAI)
    gemini          Gemini CLI (Google)
    mistral         Mistral Vibe (Mistral AI)
    opencode        OpenCode (provider-agnostic; check/push/pull only)

OPTIONS:
    --user USER     Operate on specified user (requires root for other users).
                    For pull, filters bundles by uploader; without it, pull is
                    uploader-agnostic (newest bundle per tool).
    --tool TOOL     Filter bundles by AI tool name (pull, list)
    --all           Pull to all users with AI tool configs (requires root):
                    discovers local users, then pulls each user's newest bundle
    --dry-run       Preview what would happen without making changes
    --check         Verify credentials before push (off by default)
    --skip-check    No-op (kept for compatibility; checks are already off by default)
    --check-updates Check for latest versions (env status only)
    --tmux          Set Claude Code teammateMode to "tmux" (env install only)
    --verbose       Enable verbose output for debugging
    --help, -h      Show this help message
    --version, -v   Show version information

EXAMPLES:
    cac push                    Bundle and upload current user's config (one bundle per tool)
    cac push --tool claude      Bundle and upload only Claude credentials
    cac push --tool codex       Bundle and upload only Codex credentials
    cac push --dry-run          Preview what would be bundled
    cac push --check            Verify credentials before upload (off by default)
    cac push --user ubuntu      Bundle ubuntu user's config (requires root)
    cac pull                    Pull newest bundle per tool (any uploader)
    cac pull --tool claude      Apply newest bundle for Claude tool
    cac pull --user bob         Apply newest bundle uploaded by bob (requires root)
    cac pull --dry-run          Preview what would be extracted
    cac pull CodingAgentConfig_myhost_user_250111-120000.zip
                                Download and apply a specific bundle
    cac pull mybundle           Partial match on bundle name
    sudo cac pull --all         Pull config to all users with AI tool dirs
    cac list                    List all available bundles
    cac list --tool codex       List bundles for Codex tool
    cac check                   Verify all AI tool credentials work
    cac check claude            Verify only Claude credentials
    cac check codex             Verify only Codex credentials
    cac check gemini            Verify only Gemini credentials
    cac check mistral           Verify only Mistral credentials
    cac check --user bob        Verify credentials for user bob (requires root)
    cac update                  Update cac to the latest version
    cac update --check          Check if an update is available
    cac env status              Show AI tool installation status
    cac env status --check-updates  Show status with update availability
    cac env install claude      Install Claude Code CLI
    cac env install mistral     Install Mistral Vibe CLI
    cac env install --global    Install all AI tools system-wide (requires root)
    cac env update codex        Update Codex CLI
    cac env check                   Health-check all installed tools
    cac env repair --yes            Auto-repair all detected issues
    cac env --help              Show full env subcommand help
    cac skill install https://github.com/BPMspaceUG/bpm-claude-global-agent-skill-library.git
                                    Install BPM skill library
    cac skill list              List installed skill libraries
    cac skill update            Update all installed skill libraries
    cac skill --help            Show full skill subcommand help

CONFIGURATION:
    Config file locations (in order of precedence):
      \$CAC_CONFIG_DIR/.env
      \$XDG_CONFIG_HOME/cac/.env
      ~/.config/cac/.env
      /etc/cac/.env

    Required .env variables:
      CAC_BACKEND=local|gokapi
      CAC_LOCAL_STORAGE=/path/to/storage   (for local backend)
      CAC_GOKAPI_URL=https://...           (for gokapi backend)
      CAC_GOKAPI_API_KEY=...               (for gokapi backend)

EOF
}

show_version() {
    echo "cac version ${VERSION}"
}

# ============================================================================
# Commands
# ============================================================================

# Push a single tool's config bundle (Issue #76).
# Shared by the single-tool path (`cac push --tool X`) and the batch loop
# (`cac push` with no --tool). The caller decides whether a non-success status
# aborts (single-tool) or is tallied and skipped (batch loop).
# Usage: _push_one_tool <tool> <home_dir> <target_user> <use_sudo> <skip_check> <dry_run> <temp_dir>
# Returns: 0=pushed, 10=no config (skip), 11=creds failed (skip), 12=bundle/upload failed
_push_one_tool() {
    local tool="$1"
    local home_dir="$2"
    local target_user="$3"
    local use_sudo="$4"
    local skip_check="$5"
    local dry_run="$6"
    local temp_dir="$7"

    local file_count
    file_count=$(tools_count_existing "$home_dir" "$tool" "--include-settings")
    if [[ "$file_count" -eq 0 ]]; then
        return 10
    fi

    local bundle_name
    if ! bundle_name=$(bundle_generate_filename "$target_user" "$tool"); then
        return 12
    fi

    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun "[$tool] would push $file_count file(s) as $bundle_name"
        return 0
    fi

    # Credential check (unless skipped). check_single_tool returns 100 when the
    # tool has no primary credential file — treat that as "no config" (skip),
    # any other non-zero as a credential failure.
    if [[ "$skip_check" != "true" ]]; then
        local check_rc=0
        check_single_tool "$tool" "$use_sudo" "$target_user" "$home_dir" || check_rc=$?
        if [[ "$check_rc" -eq 100 ]]; then
            return 10
        elif [[ "$check_rc" -ne 0 ]]; then
            return 11
        fi
    fi

    local bundle_path="${temp_dir}/${bundle_name}"
    if ! bundle_create "$home_dir" "$bundle_path" "$tool"; then
        return 12
    fi
    if ! backend_call upload "$bundle_path"; then
        utils_error "[$tool] upload failed to ${CAC_BACKEND} backend"
        return 12
    fi
    utils_success "[$tool] uploaded: $bundle_name"
    return 0
}

cmd_push() {
    local explicit_tool="all"
    local do_check="false"
    local args=()

    # Pre-parse push-specific --tool/-t flag or positional tool argument
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check)
                # Credential checks are OFF by default; --check opts in.
                do_check="true"
                shift
                ;;
            --tool|-t)
                if [[ $# -lt 2 ]]; then
                    utils_error "Option $1 requires an argument"
                    return 1
                fi
                explicit_tool="$(_resolve_tool_alias "$2")"
                if ! tools_is_valid "$explicit_tool"; then
                    utils_error "Unknown tool: $2"
                    echo "Valid tools: ${SUPPORTED_TOOLS[*]}" >&2
                    return 1
                fi
                shift 2
                ;;
            -*)
                args+=("$1")
                shift
                ;;
            *)
                # Positional arg: tool name if valid, otherwise pass through
                local resolved
                resolved="$(_resolve_tool_alias "$1")"
                if tools_is_valid "$resolved"; then
                    explicit_tool="$resolved"
                else
                    args+=("$1")
                fi
                shift
                ;;
        esac
    done

    # Parse remaining arguments including --skip-check, validate user access, and resolve home directory
    if ! utils_init_push_context --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    local dry_run="$PARSED_DRY_RUN"
    # Credential checks default to OFF (Issue #82): they only run when
    # explicitly requested via --check. --skip-check is accepted but redundant
    # (kept for backward compatibility, since skipping is now the default).
    local skip_check="true"
    [[ "$do_check" == "true" ]] && skip_check="false"
    local home_dir="$PARSED_HOME_DIR"

    local use_sudo="false"
    if [[ "$target_user" != "$(whoami)" ]]; then
        use_sudo="true"
    fi

    # Temp directory for bundle creation (cleaned on every return path, so
    # per-tool ZIPs never leak even if a later tool in the loop fails).
    local temp_dir
    security_init_temp_dir temp_dir "cac-push"
    trap '[[ -n "${temp_dir:-}" ]] && rm -rf "$temp_dir"' RETURN

    if [[ "$skip_check" != "true" && "$dry_run" != "true" ]]; then
        echo "=== Verifying credentials before push ==="
        echo ""
    fi

    # Single-tool push (explicit --tool X): strict — any non-success aborts.
    if [[ "$explicit_tool" != "all" ]]; then
        local rc=0
        _push_one_tool "$explicit_tool" "$home_dir" "$target_user" "$use_sudo" "$skip_check" "$dry_run" "$temp_dir" || rc=$?
        case "$rc" in
            0)
                [[ "$dry_run" == "true" ]] && utils_dryrun_footer
                return 0
                ;;
            10)
                utils_error "No configuration files found for tool '$explicit_tool' (user '$target_user')"
                return 1
                ;;
            11)
                utils_error "Credential check failed for $explicit_tool (you requested --check)."
                return 1
                ;;
            *)
                utils_error "Failed to push $explicit_tool"
                return 1
                ;;
        esac
    fi

    # Batch push (no --tool / --tool all): loop per tool, NEVER abort early.
    # Issue #76: no combined _all_ bundle — one per-tool bundle per tool.
    local pushed=0 noconfig=0 creds_failed=0 failed=0
    local tool rc
    for tool in "${SUPPORTED_TOOLS[@]}"; do
        rc=0
        _push_one_tool "$tool" "$home_dir" "$target_user" "$use_sudo" "$skip_check" "$dry_run" "$temp_dir" || rc=$?
        case "$rc" in
            0)  pushed=$((pushed + 1)) ;;
            10) utils_warn "[$tool] no config — skipped"; noconfig=$((noconfig + 1)) ;;
            11) utils_error "[$tool] credential check failed — skipped"; creds_failed=$((creds_failed + 1)) ;;
            *)  failed=$((failed + 1)) ;;
        esac
    done

    echo ""

    if [[ "$dry_run" == "true" ]]; then
        utils_dryrun_footer
        return 0
    fi

    echo "Per-tool summary: ${pushed} pushed, ${noconfig} skipped (no config), ${creds_failed} creds-failed, ${failed} failed"

    # Exit policy (Issue #76 matrix): success only if at least one tool pushed
    # AND no bundle/upload failure occurred. A failed upload after a success is
    # still a failure; creds-failed / no-config alone are non-fatal.
    if [[ "$pushed" -eq 0 ]]; then
        if [[ "$creds_failed" -gt 0 || "$failed" -gt 0 ]]; then
            utils_error "No bundles uploaded — all tools failed credential checks or upload"
        else
            utils_error "No AI tool configuration files found for user '$target_user' — nothing to push"
        fi
        return 1
    fi
    if [[ "$failed" -gt 0 ]]; then
        return 1
    fi
    return 0
}

cmd_pull() {
    local pull_all="false"
    local dry_run="false"
    local explicit_tool=""
    local tool_provided="false"
    local bundle_id=""
    local args=()

    # Pre-parse pull-specific flags (--all, --tool need special handling)
    # and capture optional positional BUNDLE_ID argument
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)
                pull_all="true"
                shift
                ;;
            --tool)
                if [[ $# -lt 2 ]]; then
                    utils_error "Option --tool requires an argument"
                    return 1
                fi
                explicit_tool="$2"
                tool_provided="true"
                shift 2
                ;;
            --user)
                # Issue #91: consume --user AND its value as a pair. Without this,
                # --user fell through to --*) (pushed alone to args) while its value
                # hit *) and was swallowed as BUNDLE_ID, so utils_init_command_context
                # later saw a bare --user and errored. Forward the pair intact for
                # standard parsing (sets PARSED_USER → --user filter in Paths A/B).
                if [[ $# -lt 2 ]]; then
                    utils_error "Option --user requires an argument"
                    return 1
                fi
                args+=("$1" "$2")
                shift 2
                ;;
            --dry-run)
                dry_run="true"
                args+=("$1")
                shift
                ;;
            --*)
                # Pass other flags through for standard parsing
                args+=("$1")
                shift
                ;;
            *)
                # First non-flag argument is the BUNDLE_ID
                if [[ -z "$bundle_id" ]]; then
                    bundle_id="$1"
                else
                    args+=("$1")
                fi
                shift
                ;;
        esac
    done

    # Handle --all mode
    if [[ "$pull_all" == "true" ]]; then
        cmd_pull_all "$dry_run"
        return $?
    fi

    # Parse arguments, validate user access, and resolve home directory
    if ! utils_init_command_context --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="$PARSED_TARGET_USER"
    dry_run="$PARSED_DRY_RUN"
    local home_dir="$PARSED_HOME_DIR"

    # If a specific BUNDLE_ID was provided, download that bundle directly
    if [[ -n "$bundle_id" ]]; then
        # Show what would happen (dry-run stops here)
        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would get bundle: $bundle_id"
            utils_dryrun "Target user: $target_user"
            utils_dryrun "Target directory: $home_dir"
            echo ""
            utils_preview_extraction "$bundle_id" "$home_dir"
            utils_dryrun_footer
            return 0
        fi

        echo "Getting bundle: $bundle_id"
        echo "Target user: $target_user"

        # Download and extract
        if ! utils_download_and_extract "$bundle_id" "$home_dir" "$target_user"; then
            return 1
        fi

        echo ""
        echo "Pull complete!"
        return 0
    fi

    # Path A: explicit --tool → single newest bundle for that tool (unchanged).
    if [[ "$tool_provided" == "true" ]]; then
        local filter_args=(--tool "$explicit_tool")
        if [[ -n "$PARSED_USER" ]]; then
            filter_args+=(--user "$PARSED_USER")
        fi

        local newest_bundle
        if ! newest_bundle=$(backend_call get_newest "${filter_args[@]}"); then
            utils_error "No bundle found matching ${filter_args[*]}"
            return 1
        fi

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would pull newest bundle (applying to user: $target_user)"
            utils_dryrun "Filters: ${filter_args[*]}"
            utils_dryrun "Target directory: $home_dir"
            utils_dryrun "Bundle to download: $newest_bundle"
            echo ""
            utils_preview_extraction "$newest_bundle" "$home_dir"
            utils_dryrun_footer
            return 0
        fi

        echo "Pulling newest bundle (applying to user: $target_user)"
        echo "Filters: ${filter_args[*]}"
        echo ""
        echo "Found bundle: $newest_bundle"
        if ! utils_download_and_extract "$newest_bundle" "$home_dir" "$target_user"; then
            return 1
        fi
        echo ""
        echo "Pull complete!"
        return 0
    fi

    # Path B: no --tool → newest bundle per supported tool (Issues #70 + #76).
    local user_filter=()
    if [[ -n "$PARSED_USER" ]]; then
        user_filter=(--user "$PARSED_USER")
    fi

    echo "Pulling newest bundle for each supported tool (applying to user: $target_user)"
    [[ ${#user_filter[@]} -gt 0 ]] && echo "Filters: ${user_filter[*]}"
    echo ""

    local extracted=0 skipped=0 failed=0
    local legacy_needed=()
    local tool
    for tool in "${SUPPORTED_TOOLS[@]}"; do
        local err_file rc=0 newest_bundle
        if ! err_file=$(mktemp); then
            utils_error "[$tool] mktemp failed"
            failed=$((failed + 1))
            continue
        fi
        newest_bundle=$(backend_call get_newest --tool "$tool" "${user_filter[@]+"${user_filter[@]}"}" 2>"$err_file") || rc=$?
        if [[ "$rc" -ne 0 ]]; then
            # Distinguish "no bundle for this tool" (expected → defer to legacy
            # fallback) from a real backend error (surface it, count as failed).
            if grep -qE '^ERROR: No bundles? found( matching:|[[:space:]])' "$err_file"; then
                legacy_needed+=("$tool")
            else
                utils_error "[$tool] backend error:"
                sed 's/^/  /' "$err_file" >&2
                failed=$((failed + 1))
            fi
            rm -f "$err_file"
            continue
        fi
        rm -f "$err_file"

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "[$tool] would pull: $newest_bundle"
            utils_preview_extraction "$newest_bundle" "$home_dir"
            extracted=$((extracted + 1))
            continue
        fi

        echo "[$tool] Found bundle: $newest_bundle"
        if utils_download_and_extract "$newest_bundle" "$home_dir" "$target_user"; then
            extracted=$((extracted + 1))
        else
            utils_error "[$tool] extract failed"
            failed=$((failed + 1))
        fi
    done

    # Legacy _all_ read-fallback (Issue #76, migration safety): for tools with no
    # per-tool bundle, extract that tool's files from the newest legacy combined
    # bundle. Kept for at least one release cycle; push never creates _all_ again.
    if [[ ${#legacy_needed[@]} -gt 0 ]]; then
        _pull_legacy_fallback "$home_dir" "$target_user" "$dry_run" \
            legacy_needed extracted skipped failed \
            "${user_filter[@]+"${user_filter[@]}"}"
    fi

    echo ""
    echo "Per-tool summary: ${extracted} extracted, ${skipped} skipped, ${failed} failed"

    if [[ "$failed" -gt 0 ]]; then
        return 1
    fi
    if [[ "$extracted" -eq 0 ]]; then
        utils_error "No bundles were extracted"
        return 1
    fi
    return 0
}

# Legacy _all_ read-fallback for `cac pull` with no --tool (Issue #76).
# Downloads the newest legacy combined bundle once and extracts each deferred
# tool's files from it (tool-filtered, so a fresher per-tool bundle is never
# clobbered). Counters are passed by name-ref and updated in place.
# Usage: _pull_legacy_fallback <home_dir> <target_user> <dry_run> \
#            <needed_arr> <extracted_ref> <skipped_ref> <failed_ref> [--user U]
_pull_legacy_fallback() {
    local home_dir="$1" target_user="$2" dry_run="$3"
    local -n _needed="$4"
    local -n _extracted="$5"
    local -n _skipped="$6"
    local -n _failed="$7"
    shift 7
    local user_filter=("$@")

    local legacy_bundle="" lrc=0 lerr
    lerr=$(mktemp 2>/dev/null) || lerr="/dev/null"
    legacy_bundle=$(backend_call get_newest --tool all "${user_filter[@]+"${user_filter[@]}"}" 2>"$lerr") || lrc=$?
    [[ "$lerr" != "/dev/null" ]] && rm -f "$lerr"

    local tool
    if [[ "$lrc" -ne 0 || -z "$legacy_bundle" ]]; then
        for tool in "${_needed[@]}"; do
            utils_warn "[$tool] no bundle available — skipping"
            _skipped=$((_skipped + 1))
        done
        return 0
    fi

    # Download the legacy bundle once; extract per tool with a filter.
    local ldir lpath
    security_init_temp_dir ldir "cac-legacy"
    lpath="${ldir}/$(basename "$legacy_bundle")"
    if ! backend_call download "$legacy_bundle" "$lpath"; then
        for tool in "${_needed[@]}"; do
            utils_warn "[$tool] no bundle available — skipping"
            _skipped=$((_skipped + 1))
        done
        rm -rf "$ldir"
        return 0
    fi

    local zip_entries
    zip_entries=$(security_list_zip_entries "$lpath")

    for tool in "${_needed[@]}"; do
        # Does the legacy bundle actually contain any of this tool's files?
        local has=false tf
        while IFS= read -r tf; do
            [[ -z "$tf" ]] && continue
            if grep -qxF "$tf" <<<"$zip_entries"; then
                has=true
                break
            fi
        done < <(tools_get_files "$tool" "--include-settings")

        if [[ "$has" != "true" ]]; then
            utils_warn "[$tool] no bundle available — skipping"
            _skipped=$((_skipped + 1))
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "[$tool] would pull from legacy combined bundle: $legacy_bundle"
            _extracted=$((_extracted + 1))
            continue
        fi

        echo "[$tool] no per-tool bundle — using legacy combined bundle: $legacy_bundle"
        if bundle_extract "$lpath" "$home_dir" "$target_user" "$tool"; then
            _extracted=$((_extracted + 1))
        else
            utils_error "[$tool] legacy extract failed"
            _failed=$((_failed + 1))
        fi
    done

    rm -rf "$ldir"
    return 0
}

# Discover local users who have any AI tool config dir/file (Issue #89).
# Extracted from cmd_pull_all so the discovery set is unit-testable without root.
# Emits one username per line in encounter order, de-duplicated.
# Discovery dirs mirror the per-tool paths in lib/tools.sh _TOOLS_REGISTRY;
# opencode config lives under .config/opencode and .local/share/opencode.
_pull_all_find_users() {
    local users_found=()
    local tool_dirs=(".claude" ".codex" ".gemini" ".vibe" ".config/opencode" ".local/share/opencode")
    local tool_files=(".claude.json")

    while IFS= read -r user_home; do
        [[ -d "$user_home" ]] || continue
        local username
        username=$(basename "$user_home")
        local found=false

        # Check for config directories
        for tool_dir in "${tool_dirs[@]}"; do
            if [[ -d "${user_home}/${tool_dir}" ]]; then
                found=true
                break
            fi
        done

        # Check for config files (e.g., .claude.json)
        if [[ "$found" != "true" ]]; then
            for tool_file in "${tool_files[@]}"; do
                if [[ -f "${user_home}/${tool_file}" ]]; then
                    found=true
                    break
                fi
            done
        fi

        if [[ "$found" == "true" && ! " ${users_found[*]} " =~ \ ${username}\  ]]; then
            users_found+=("$username")
        fi
    done < <(platform_list_user_homes)

    if [[ ${#users_found[@]} -gt 0 ]]; then
        printf '%s\n' "${users_found[@]}"
    fi
}

# Pull config to all users who have AI tool directories
cmd_pull_all() {
    local dry_run="${1:-false}"

    # Cross-user operations are not supported on Windows (no sudo / POSIX users)
    if platform_is_windows; then
        utils_error "--all is not supported on Windows Git Bash. Run as the target user without --all."
        return 1
    fi

    # Require root
    if [[ "$EUID" -ne 0 ]]; then
        utils_error "Root required for --all (pulls to all users)"
        return 1
    fi

    echo "=== Pulling config to all AI tool users ==="
    echo ""

    # Find users with AI tool config directories or files (Issue #89: incl. opencode)
    local users_found=()
    while IFS= read -r username; do
        [[ -n "$username" ]] && users_found+=("$username")
    done < <(_pull_all_find_users)

    if [[ ${#users_found[@]} -eq 0 ]]; then
        echo "No users with AI tool configs found (.claude, .codex, .gemini, .vibe, .config/opencode, .claude.json)"
        return 0
    fi

    echo "Found ${#users_found[@]} user(s) with AI tool configs:"
    printf '  - %s\n' "${users_found[@]}"
    echo ""

    local success=0
    local failed=0

    for username in "${users_found[@]}"; do
        echo "--- Processing: $username ---"

        local home_dir
        if [[ "$username" == "root" ]]; then
            home_dir="/root"
        else
            home_dir="/home/$username"
        fi

        # Find newest bundle for this user
        local newest_bundle
        if ! newest_bundle=$(backend_call get_newest --user "$username" 2>/dev/null); then
            echo "  No bundle found for $username, skipping"
            echo ""
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            utils_dryrun "Would pull $newest_bundle to $home_dir"
        else
            echo "  Bundle: $newest_bundle"
            if utils_download_and_extract "$newest_bundle" "$home_dir" "$username"; then
                echo "  OK"
                ((success++)) || true
            else
                echo "  FAILED"
                ((failed++)) || true
            fi
        fi
        echo ""
    done

    echo "=== Summary ==="
    echo "Success: $success, Failed: $failed, Total: ${#users_found[@]}"
}

# Silent alias: 'cac get' redirects to 'cac pull' for backward compatibility
cmd_get() {
    cmd_pull "$@"
}

cmd_list() {
    backend_call list "$@"
}

cmd_check() {
    local tool_arg=""
    local args=()

    # Extract tool argument (first non-option argument), resolve aliases
    for arg in "$@"; do
        if [[ "$arg" != --* && -z "$tool_arg" ]]; then
            tool_arg="$(_resolve_tool_alias "$arg")"
        else
            args+=("$arg")
        fi
    done

    # Parse remaining arguments
    if ! utils_parse_user_arg --strict "${args[@]+"${args[@]}"}"; then
        return 1
    fi
    local target_user="${PARSED_USER:-$USER}"
    local use_sudo="false"

    # Check if checking another user
    if [[ "$target_user" != "$(whoami)" ]]; then
        if [[ "$EUID" -ne 0 ]]; then
            utils_error "Root required to check as another user"
            return 1
        fi
        use_sudo="true"
    fi

    # Resolve home directory
    local home_dir
    if ! home_dir=$(security_resolve_user_home "$target_user"); then
        return 1
    fi

    echo "=== Checking AI Tool Credentials for user: $target_user ==="
    echo ""

    if [[ -n "$tool_arg" && "$tool_arg" != "all" ]]; then
        # Check specific tool
        check_single_tool "$tool_arg" "$use_sudo" "$target_user" "$home_dir"
    else
        # No tool given, or the literal "all" -> check every tool (Issue #84)
        check_all_tools "$use_sudo" "$target_user" "$home_dir"
    fi
}

# Alias: cmd_test is now an alias for cmd_check (backward compatibility)
cmd_test() {
    cmd_check "$@"
}

cmd_env() {
    local subcommand="${1:-status}"
    shift || true

    # Resolve tool aliases in arguments (e.g., "vibe" -> "mistral")
    local resolved_args=()
    for arg in "$@"; do
        if [[ "$arg" != -* ]]; then
            resolved_args+=("$(_resolve_tool_alias "$arg")")
        else
            resolved_args+=("$arg")
        fi
    done

    case "$subcommand" in
        install)
            env_cmd_install "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        update)
            env_cmd_update "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        status)
            env_cmd_status "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        check)
            env_cmd_check "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        repair)
            env_cmd_repair "${resolved_args[@]+"${resolved_args[@]}"}"
            ;;
        skills)
            env_cmd_skills "$@"
            ;;
        --help|-h)
            cat <<EOF
cac env - Manage AI tool environments

USAGE:
    cac env <subcommand> [options]

SUBCOMMANDS:
    install [TOOL] [--user|--global] [--yes] [--tmux]  Install AI tool environments
    update [TOOL] [--user|--global]           Update AI tool environments
    status [--parseable] [--check-updates]    Show installation status
    check [TOOL] [--parseable]               Health-check installed tools
    repair [TOOL] [--yes]                    Repair detected health issues
    skills [--yes] [--list]                  Install predefined Claude Code skills

TOOLS:
    claude            Claude Code CLI
    codex             OpenAI Codex CLI
    gemini            Google Gemini CLI
    mistral (vibe)    Mistral Vibe CLI
    continuous-claude continuous-claude (optional)

OPTIONS:
    --user            Install/update for current user only (default)
    --global          Install/update system-wide (requires root)
    --yes, -y         Skip confirmation prompts
    --parseable       Output status in tab-separated format
    --check-updates   Check for latest versions (env status only)
    --tmux            Set Claude Code teammateMode to "tmux" (install only)

EXAMPLES:
    cac env status                    Show status of all AI tools
    cac env install                   Interactive tool selection
    cac env install claude            Install Claude Code
    cac env install --global          Install all tools system-wide
    cac env update codex              Update Codex CLI
    cac env status --parseable        Machine-readable status output
    cac env status --check-updates    Show status with update availability
    cac env check                     Health-check all installed AI tools
    cac env check claude              Check only Claude Code health
    cac env check --parseable         Machine-readable check output
    cac env repair                    Repair all detected issues (interactive)
    cac env repair --yes              Repair without confirmation prompts
    cac env repair codex              Repair only Codex CLI
    cac env skills                    Install predefined Claude Code skills
    cac env skills --list             List predefined skills without installing

EOF
            ;;
        *)
            utils_error "Unknown env subcommand: $subcommand"
            echo "Run 'cac env --help' for usage information." >&2
            return 1
            ;;
    esac
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Handle global options first (can appear before or after command)
    local args=()
    for arg in "$@"; do
        case "$arg" in
            --verbose)
                logging_set_verbose
                ;;
            *)
                args+=("$arg")
                ;;
        esac
    done
    set -- "${args[@]}"

    # Handle help and version first (no config required)
    case "${1:-}" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v)
            show_version
            exit 0
            ;;
        "")
            show_help
            exit 0
            ;;
    esac

    # Print version on every command invocation
    echo "cac v${VERSION}"

    local command="$1"
    shift

    utils_verbose "Command: $command"

    # Check/test/env commands don't require backend config
    if [[ "$command" == "check" || "$command" == "test" ]]; then
        cmd_check "$@"
        exit $?
    fi

    if [[ "$command" == "env" ]]; then
        cmd_env "$@"
        exit $?
    fi

    if [[ "$command" == "skill" ]]; then
        skill_cmd_main "$@"
        exit $?
    fi

    if [[ "$command" == "update" ]]; then
        update_cmd_main "$@"
        exit $?
    fi

    # Load configuration for all other commands
    if ! config_load; then
        exit 1
    fi

    if ! config_validate; then
        exit 1
    fi

    # Dispatch command
    case "$command" in
        push)
            cmd_push "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        get)
            cmd_get "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        *)
            utils_error "Unknown command: $command"
            echo "Run 'cac --help' for usage information." >&2
            exit 1
            ;;
    esac
}

# When sourced as a library (e.g., tests), skip main execution.
# Standard bash idiom: 'return' is valid only when sourced.
(return 0 2>/dev/null) || main "$@"
