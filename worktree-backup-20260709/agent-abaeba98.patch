+test_local_list_sorted_by_filename_not_mtime() {
+    # P1 regression: Verify that sorting uses the filename-embedded timestamp,
+    # not filesystem mtime. When files are copied, mtime can diverge from the
+    # timestamp in the filename, causing the wrong bundle to be selected.
+    source "${PROJECT_ROOT}/lib/config.sh"
+    source "${PROJECT_ROOT}/lib/backend_local.sh"
+
+    export CAC_CONFIG_DIR="$TEST_CONFIG_DIR"
+    config_load 2>/dev/null
+
+    # Create a dedicated storage dir to avoid interference from other tests
+    local iso_storage="${TEST_TMPDIR}/mtime_test_storage"
+    mkdir -p "$iso_storage"
+
+    # Bundle with NEWER filename timestamp but created FIRST (older mtime)
+    local newer_name="${iso_storage}/CodingAgentConfig_host1_user1_250201-120000.zip"
+    echo "newer-by-name" | zip -q "$newer_name" -
+
+    sleep 1
+
+    # Bundle with OLDER filename timestamp but created SECOND (newer mtime)
+    local older_name="${iso_storage}/CodingAgentConfig_host1_user1_250101-060000.zip"
+    echo "older-by-name" | zip -q "$older_name" -
+
+    # The file with the newer mtime is the one with the OLDER filename timestamp.
+    # Before the fix, mtime-based sorting would return older_name first (wrong).
+    # After the fix, filename-based sorting returns newer_name first (correct).
+    local result
+    result=$(_local_list_bundle_files "$iso_storage" | head -1)
+
+    assert_equals "$newer_name" "$result" "filename-timestamp sorting beats mtime" || { unset CAC_CONFIG_DIR; return 1; }
+    unset CAC_CONFIG_DIR
+}
