diff --git a/tests/test_install.sh b/tests/test_install.sh
index ba5e562..946bf1d 100755
--- a/tests/test_install.sh
+++ b/tests/test_install.sh
@@ -2224,6 +2224,195 @@ test_write_config_user_permissions_600() {
     assert_equals "600" "$perms" "user config permissions"
 }
 
+# ============================================================================
+# Issue #65: --env-file flag tests
+# ============================================================================
+
+INSTALL_SH="${SCRIPT_DIR}/../install.sh"
+
+test_env_file_valid_copies() {
+    # Create a valid .env file
+    local env_source="${TEST_TMPDIR}/envfile_valid.env"
+    echo "CAC_BACKEND=local" > "$env_source"
+    echo "CAC_LOCAL_STORAGE=/tmp/bundles" >> "$env_source"
+
+    # Run install.sh --help first to verify --env-file is accepted
+    # Then run with --user and --env-file to test config copy
+    # We use --user to avoid root requirement, but the install will fail
+    # at download stage. We just need to verify the argument is parsed.
+    local output
+    output=$(bash "$INSTALL_SH" --env-file "$env_source" --user 2>&1) || true
+
+    # The installer should NOT fail with "Unknown option: --env-file"
+    if echo "$output" | grep -q "Unknown option.*env-file"; then
+        echo "install.sh did not recognize --env-file flag" >&2
+        return 1
+    fi
+    return 0
+}
+
+test_env_file_missing_fails() {
+    local output
+    if output=$(bash "$INSTALL_SH" --env-file "/nonexistent/path.env" 2>&1); then
+        echo "Expected failure for missing --env-file path" >&2
+        return 1
+    fi
+    assert_contains "file not found" "$output" "error mentions file not found"
+}
+
+test_env_file_no_arg_fails() {
+    local output
+    if output=$(bash "$INSTALL_SH" --env-file 2>&1); then
+        echo "Expected failure for --env-file without argument" >&2
+        return 1
+    fi
+    assert_contains "requires a path" "$output" "error mentions requires a path"
+}
+
+test_env_file_unreadable_fails() {
+    local unreadable="${TEST_TMPDIR}/unreadable.env"
+    echo "test" > "$unreadable"
+    chmod 000 "$unreadable"
+
+    local output
+    if output=$(bash "$INSTALL_SH" --env-file "$unreadable" 2>&1); then
+        chmod 600 "$unreadable"
+        echo "Expected failure for unreadable --env-file" >&2
+        return 1
+    fi
+
+    chmod 600 "$unreadable"
+    assert_contains "not readable" "$output" "error mentions not readable"
+}
+
+# ============================================================================
+# Issue #65: Early root check tests
+# ============================================================================
+
+test_global_without_root_fails_early() {
+    # Skip if running as root
+    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
+        echo "SKIP: Test requires non-root" >&2
+        return 0
+    fi
+
+    local output
+    if output=$(bash "$INSTALL_SH" --global 2>&1); then
+        echo "Expected --global without root to fail" >&2
+        return 1
+    fi
+
+    assert_contains "--global requires root privileges" "$output" "root error message" &&
+    assert_contains "sudo ./install.sh --global" "$output" "sudo hint"
+}
+
+test_all_without_root_fails_early() {
+    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
+        echo "SKIP: Test requires non-root" >&2
+        return 0
+    fi
+
+    local output
+    if output=$(bash "$INSTALL_SH" --all 2>&1); then
+        echo "Expected --all without root to fail" >&2
+        return 1
+    fi
+
+    assert_contains "--all requires root privileges" "$output" "root error message" &&
+    assert_contains "sudo ./install.sh --all" "$output" "sudo hint"
+}
+
+test_global_error_before_banner() {
+    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
+        echo "SKIP: Test requires non-root" >&2
+        return 0
+    fi
+
+    local output
+    output=$(bash "$INSTALL_SH" --global 2>&1) || true
+
+    # If early check works, the banner "Coding Agent Config" should NOT appear
+    if echo "$output" | grep -q "Coding Agent Config"; then
+        echo "Banner appeared before root check — early check not working" >&2
+        return 1
+    fi
+    return 0
+}
+
+# ============================================================================
+# Issue #65: curl auto-install tests
+# ============================================================================
+
+test_curl_missing_nonroot_hint() {
+    # We cannot actually remove curl, but we test the function logic
+    # by loading check_dependencies and overriding command
+    local check_fn
+    check_fn=$(sed -n '/^check_dependencies()/,/^}/p' "$INSTALL_SH")
+
+    local output
+    output=$(
+        is_root() { return 1; }
+        info() { echo "[INFO] $*"; }
+        success() { echo "[OK] $*"; }
+        die() { echo "[ERROR] $*" >&2; exit 1; }
+        eval "$check_fn"
+
+        # Override command to simulate missing curl
+        command() {
+            if [[ "$1" == "-v" && "$2" == "curl" ]]; then
+                return 1
+            fi
+            builtin command "$@"
+        }
+
+        check_dependencies 2>&1
+    ) && {
+        echo "Expected check_dependencies to fail when curl missing" >&2
+        return 1
+    }
+
+    assert_contains "curl is required but not installed" "$output" "curl missing message" &&
+    assert_contains "sudo apt-get install -y curl" "$output" "install hint"
+}
+
+test_curl_present_no_action() {
+    # When curl is present, check_dependencies should succeed without mentioning curl
+    local check_fn
+    check_fn=$(sed -n '/^check_dependencies()/,/^}/p' "$INSTALL_SH")
+
+    local output
+    output=$(
+        is_root() { return 1; }
+        info() { echo "[INFO] $*"; }
+        success() { echo "[OK] $*"; }
+        die() { echo "[ERROR] $*" >&2; exit 1; }
+        eval "$check_fn"
+        check_dependencies 2>&1
+    )
+    local rc=$?
+
+    [[ $rc -eq 0 ]] || { echo "Expected success when curl present" >&2; return 1; }
+    # Should not mention auto-installing curl
+    if echo "$output" | grep -q "curl not found"; then
+        echo "Should not try to install curl when it is present" >&2
+        return 1
+    fi
+    return 0
+}
+
+# ============================================================================
+# Issue #65: Help text tests
+# ============================================================================
+
+test_help_includes_env_file() {
+    local output
+    output=$(bash "$INSTALL_SH" --help 2>&1)
+    local rc=$?
+
+    [[ $rc -eq 0 ]] || { echo "Expected --help to succeed" >&2; return 1; }
+    assert_contains "--env-file" "$output" "help text includes --env-file"
+}
+
 # ============================================================================
 # Run new tests
 # ============================================================================
@@ -2282,5 +2471,27 @@ run_test "writes gokapi config" test_write_config_gokapi
 run_test "writes local config" test_write_config_local
 run_test "user config gets 600 permissions" test_write_config_user_permissions_600
 
+echo ""
+echo "--- --env-file flag (Issue #65) ---"
+run_test "env-file with valid file copies config" test_env_file_valid_copies
+run_test "env-file with missing file fails" test_env_file_missing_fails
+run_test "env-file without argument fails" test_env_file_no_arg_fails
+run_test "env-file with unreadable file fails" test_env_file_unreadable_fails
+
+echo ""
+echo "--- Early root check (Issue #65) ---"
+run_test "--global without root fails early" test_global_without_root_fails_early
+run_test "--all without root fails early" test_all_without_root_fails_early
+run_test "--global error appears before banner" test_global_error_before_banner
+
+echo ""
+echo "--- curl auto-install (Issue #65) ---"
+run_test "curl missing non-root shows install hint" test_curl_missing_nonroot_hint
+run_test "curl present skips auto-install" test_curl_present_no_action
+
+echo ""
+echo "--- Help text (Issue #65) ---"
+run_test "help includes --env-file" test_help_includes_env_file
+
 echo ""
 framework_report
