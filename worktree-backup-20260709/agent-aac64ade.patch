 # Check for required dependencies
+# curl is auto-installed if running as root; zip/unzip/git remain hard errors
 check_dependencies() {
+    # Handle curl specially: auto-install if root, helpful error if not
+    if ! command -v curl &>/dev/null; then
+        if is_root; then
+            info "curl not found — installing via apt-get..."
+            if apt-get install -y curl >/dev/null 2>&1; then
+                success "Installed curl"
+            else
+                die "Failed to install curl via apt-get"
+            fi
+        else
+            die "curl is required but not installed. Install it with: sudo apt-get install -y curl"
+        fi
+    fi
+
     local missing=()
 
-    for cmd in curl unzip zip git; do
+    for cmd in unzip zip git; do
         if ! command -v "$cmd" &>/dev/null; then
             missing+=("$cmd")
         fi
@@ -144,6 +159,75 @@ get_latest_version() {
     fi
 }
 
+# Detect if local project files exist relative to this script
+# Returns 0 if all required files found, 1 otherwise
+# Note: BASH_SOURCE[0] is empty/unreliable when piped via curl, so detection safely returns false
+detect_local_files() {
+    local script_path="${BASH_SOURCE[0]:-}"
+    [[ -n "$script_path" && -f "$script_path" ]] || return 1
+
+    local script_dir
+    script_dir="$(cd "$(dirname "$script_path")" && pwd)"
+
+    [[ -f "${script_dir}/bin/cac" ]] || return 1
+    [[ -f "${script_dir}/lib/config.sh" ]] || return 1
+    [[ -f "${script_dir}/lib/security.sh" ]] || return 1
+    [[ -f "${script_dir}/lib/bundle.sh" ]] || return 1
+
+    return 0
+}
+
+# Copy local project files to temp directory (same layout as download_project)
+copy_local_files() {
+    local temp_dir="$1"
+    local script_dir
+    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+    info "Using local project files from ${script_dir}..."
+
+    if ! mkdir -p "${temp_dir}/bin" "${temp_dir}/lib" "${temp_dir}/completions"; then
+        die "Failed to create temporary directories"
+    fi
+
+    # Copy main CLI
+    cp "${script_dir}/bin/cac" "${temp_dir}/bin/cac"
+    chmod +x "${temp_dir}/bin/cac"
+
+    # Copy library modules
+    local libs=(config.sh security.sh tools.sh bundle.sh backend_local.sh backend_gokapi.sh utils.sh logging.sh check.sh env.sh skill.sh update.sh)
+    for lib in "${libs[@]}"; do
+        if [[ -f "${script_dir}/lib/${lib}" ]]; then
+            cp "${script_dir}/lib/${lib}" "${temp_dir}/lib/${lib}"
+        fi
+    done
+
+    # Verify required libraries were copied
+    local missing_libs=()
+    for lib in "${libs[@]}"; do
+        if [[ ! -f "${temp_dir}/lib/${lib}" ]]; then
+            missing_libs+=("$lib")
+        fi
+    done
+    if [[ ${#missing_libs[@]} -gt 0 ]]; then
+        die "Missing required local libraries: ${missing_libs[*]}"
+    fi
+
+    # Copy example config
+    if [[ -f "${script_dir}/.env.example" ]]; then
+        cp "${script_dir}/.env.example" "${temp_dir}/.env.example"
+    fi
+
+    # Copy shell completion files (optional)
+    if [[ -f "${script_dir}/completions/cac.bash" ]]; then
+        cp "${script_dir}/completions/cac.bash" "${temp_dir}/completions/cac.bash"
+    fi
+    if [[ -f "${script_dir}/completions/_cac" ]]; then
+        cp "${script_dir}/completions/_cac" "${temp_dir}/completions/_cac"
+    fi
+
+    success "Copied local files to staging area"
+}
+
 # Download and verify a file
 download_file() {
     local url="$1"
@@ -423,6 +507,20 @@ resolve_config_value() {
 setup_config() {
     local env_file="${CONFIG_DIR}/.env"
 
+    # --env-file takes priority: copy supplied file and skip all prompts
+    if [[ -n "$ARG_ENV_FILE" ]]; then
+        cp "$ARG_ENV_FILE" "$env_file"
+        # System config (/etc/cac/.env) needs 644 so non-root users can read it
+        # User config (~/.config/cac/.env) stays 600 (private)
+        if [[ "$env_file" == "/etc/cac/.env" ]]; then
+            chmod 644 "$env_file"
+        else
+            chmod 600 "$env_file"
+        fi
+        success "Installed configuration from ${ARG_ENV_FILE} to ${env_file}"
+        return 0
+    fi
+
     if [[ -f "$env_file" ]]; then
         info "Existing configuration found at: $env_file"
         return 0
