-# Install all core tools
-# Usage: env_install_all <scope> [flags...]
+# Install all core tools (or all tools including optional)
+# Usage: env_install_all <scope> [include_optional] [flags...]
+# Args:  include_optional - "true" to include optional tools, default core only
 # Returns: 0 all succeeded, 1 partial, 2 all failed
 env_install_all() {
     local scope="${1:-user}"
     shift || true
+    local include_optional="false"
+    if [[ "${1:-}" == "true" || "${1:-}" == "false" ]]; then
+        include_optional="$1"
+        shift || true
+    fi
     local -a extra_flags=("$@")
     local success=0
     local updated=0
     local failed=0
 
-    echo "Installing all core AI tools..."
+    if [[ "$include_optional" == "true" ]]; then
+        echo "Installing all AI tools (including optional)..."
+    else
+        echo "Installing all core AI tools..."
+    fi
     echo ""
 
+    local tool_list_cmd="env_get_core_tools"
+    [[ "$include_optional" == "true" ]] && tool_list_cmd="env_get_all_tools"
+
     while IFS= read -r tool; do
         # Issue #49: installed tools get updated via env_install_tool
         if env_is_installed "$tool"; then
@@ -712,7 +725,7 @@ env_install_all() {
             fi
         fi
         echo ""
-    done < <(env_get_core_tools)
+    done < <($tool_list_cmd)
 
     echo "=== Installation Summary ==="
     echo "Installed: $success"
@@ -2046,11 +2059,17 @@ env_cmd_install() {
     [[ "$ENV_PARSED_YES" == "true" ]] && extra_flags+=("--yes")
     [[ "$ENV_PARSED_TMUX" == "true" ]] && extra_flags+=("--tmux")
 
+    # Issue #64: "all" keyword installs all tools including optional
+    if [[ ${#ENV_PARSED_TOOLS[@]} -eq 1 && "${ENV_PARSED_TOOLS[0]}" == "all" ]]; then
+        env_install_all "$scope" "true" "${extra_flags[@]+"${extra_flags[@]}"}"
+        return $?
+    fi
+
     # No tools specified
     if [[ ${#ENV_PARSED_TOOLS[@]} -eq 0 ]]; then
         if [[ "${ENV_PARSED_YES}" == "true" ]]; then
             # --yes flag: skip interactive menu, install all core tools
-            env_install_all "$scope" "${extra_flags[@]+"${extra_flags[@]}"}"
+            env_install_all "$scope" "false" "${extra_flags[@]+"${extra_flags[@]}"}"
             return $?
         elif [[ -t 0 ]]; then
             # Interactive terminal: show selection menu
@@ -2059,7 +2078,7 @@ env_cmd_install() {
