diff --git a/lib/env.sh b/lib/env.sh
index 5f87680..1901efa 100644
--- a/lib/env.sh
+++ b/lib/env.sh
@@ -728,6 +728,52 @@ env_install_all() {
     fi
 }
 
+# Install ALL tools including optional ones
+# Usage: env_install_all_tools <scope> [flags...]
+# Returns: 0 all succeeded, 1 partial, 2 all failed
+env_install_all_tools() {
+    local scope="${1:-user}"
+    shift || true
+    local -a extra_flags=("$@")
+    local success=0
+    local updated=0
+    local failed=0
+
+    echo "Installing all AI tools (including optional)..."
+    echo ""
+
+    while IFS= read -r tool; do
+        # Issue #49: installed tools get updated via env_install_tool
+        if env_is_installed "$tool"; then
+            if env_install_tool "$tool" "$scope" "${extra_flags[@]+"${extra_flags[@]}"}"; then
+                ((updated++)) || true
+            else
+                ((failed++)) || true
+            fi
+        else
+            if env_install_tool "$tool" "$scope" "${extra_flags[@]+"${extra_flags[@]}"}"; then
+                ((success++)) || true
+            else
+                ((failed++)) || true
+            fi
+        fi
+        echo ""
+    done < <(env_get_all_tools)
+
+    echo "=== Installation Summary ==="
+    echo "Installed: $success"
+    echo "Updated: $updated"
+    echo "Failed: $failed"
+
+    if [[ $failed -eq 0 ]]; then
+        return $ENV_EXIT_SUCCESS
+    elif [[ $((success + updated)) -gt 0 ]]; then
+        return $ENV_EXIT_PARTIAL
+    else
+        return $ENV_EXIT_ALL_FAILED
+    fi
+}
+
 # Update all installed tools
 # Usage: env_update_all <scope>
 # Returns: 0 all succeeded, 1 partial, 2 all failed
@@ -2064,6 +2110,12 @@ env_cmd_install() {
         fi
     fi
 
+    # Intercept "all" keyword: install all tools including optional (Issue #64)
+    if [[ ${#ENV_PARSED_TOOLS[@]} -eq 1 && "${ENV_PARSED_TOOLS[0]}" == "all" ]]; then
+        env_install_all_tools "$scope" "${extra_flags[@]+"${extra_flags[@]}"}"
+        return $?
+    fi
+
     # Install specified tools
     local success=0
     local failed=0
