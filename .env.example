# cac - Coding Agent Config
# Copy this file to one of the following locations and set permissions:
#   User-local: ~/.config/cac/.env (chmod 600)
#   System-wide: /etc/cac/.env (chmod 600, owned by root)

# Backend selection: local or gokapi
CAC_BACKEND=local

# Local filesystem backend settings
# Directory where bundles are stored (must exist and be writable)
CAC_LOCAL_STORAGE=/var/lib/cac/bundles

# Gokapi backend settings (for remote storage)
# CAC_GOKAPI_URL=https://your-gokapi-instance.example.com
# CAC_GOKAPI_API_KEY=your-api-key-here

# Gokapi expiry settings
# CAC_GOKAPI_EXPIRY_DAYS=7        # 1-7 days (0 or >7 defaults to 7 for security)
# CAC_GOKAPI_ALLOWED_DOWNLOADS=0  # 0 = unlimited downloads
